{
  "name": "upkeep-axi",
  "version": "0.1.0",
  "private": true,
  "description": "AXI CLI that reports update inventory (installed vs available, semver tier, PATH skew) for this workstation and delegates updates to each vendor's own updater",
  "type": "module",
  "bin": {
    "upkeep-axi": "./dist/bin/upkeep-axi.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "dev": "tsx bin/upkeep-axi.ts",
    "lint": "eslint bin src test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@toon-format/toon": "2.1.0",
    "axi-sdk-js": "^0.1.10"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.0.0",
    "eslint": "10.1.0",
    "globals": "17.7.0",
    "prettier": "3.8.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.0",
    "vitest": "3.0.0"
  }
}
